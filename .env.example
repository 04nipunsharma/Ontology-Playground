# Copy to .env.local and fill in. Never commit real secrets.

# --- App features -----------------------------------------------------------
VITE_ENABLE_AI_BUILDER=false
VITE_ENABLE_LEGACY_FORMATS=false

# GitHub repo holding the catalogue (used by the "submit to catalogue" PR flow).
# Optional: deployed builds use the repo they were built from.
VITE_CATALOGUE_REPO=
# GitHub OAuth app for the PR flow (optional)
VITE_GITHUB_CLIENT_ID=

# --- Microsoft Fabric ------------------------------------------------------------
# Pre-fills the workspace in "Push to Fabric" (browser) — GUID from the workspace URL
VITE_FABRIC_WORKSPACE_ID=

# Used by `npm run fabric:deploy` (CLI / GitHub Actions)
FABRIC_WORKSPACE_ID=
# Optional: a bearer token for the Fabric API. If empty, the script uses `az login`.
FABRIC_TOKEN=

# --- Azure OpenAI (optional AI ontology builder in /api) -----------------------
# Configure in api/local.settings.json (see api/local.settings.json.template)
