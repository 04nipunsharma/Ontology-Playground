        <rdfs:label>suggestedSupplier</rdfs:label>
        <rdfs:domain rdf:resource="https://ontology.komatsu.com.au/komatsu-au-05-planning/PlannedOrder"/>
        <rdfs:range rdf:resource="https://ontology.komatsu.com.au/komatsu-au-05-planning/Supplier"/>
        <rdfs:comment>A planned purchase suggests a supplier</rdfs:comment>
        <kau:cardinality>many-to-one</kau:cardinality>
        <kau:fromEntityId>plannedOrder</kau:fromEntityId>
        <kau:toEntityId>supplier</kau:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://ontology.komatsu.com.au/komatsu-au-05-planning/firmedAsPurchaseOrder">
