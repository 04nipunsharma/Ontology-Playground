        <kau:fromEntityId>plannedOrder</kau:fromEntityId>
        <kau:toEntityId>purchaseOrder</kau:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://ontology.komatsu.com.au/komatsu-au-05-planning/firmedAsTransfer">
