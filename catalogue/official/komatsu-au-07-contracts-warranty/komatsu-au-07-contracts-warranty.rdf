        <kau:color>#1A5276</kau:color>
        <kau:processDomain>Contracts &amp; Warranty</kau:processDomain>
        <kau:dataOwner>Warranty Administrator</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>schema.org: WarrantyPromise (exactMatch)</kau:alignsTo>
        <skos:exactMatch rdf:resource="https://schema.org/WarrantyPromise"/>
        <kau:alignsTo>GS1 Web Vocabulary: WarrantyPromise (closeMatch)</kau:alignsTo>
        <skos:closeMatch rdf:resource="https://gs1.org/voc/WarrantyPromise"/>
        <kau:alignsTo>Australian Consumer Law: Consumer guarantees / warranty against defects (reg 90) (related)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-07-contracts-warranty/WarrantyClaim">
        <rdfs:label>WarrantyClaim</rdfs:label>
        <rdfs:comment>A claim to the factory or a supplier to recover the cost of a warranty repair, campaign or policy/goodwill decision.</rdfs:comment>
        <skos:altLabel>OEM warranty claim</skos:altLabel>
        <skos:altLabel>Dealer warranty claim</skos:altLabel>
        <skos:altLabel>Supplier recovery</skos:altLabel>
        <kau:icon>📨</kau:icon>
        <kau:color>#1A5276</kau:color>
        <kau:processDomain>Contracts &amp; Warranty</kau:processDomain>
        <kau:dataOwner>Warranty Administrator</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>OAGIS: WarrantyClaim (closeMatch)</kau:alignsTo>
        <kau:alignsTo>IOF: FailureEvent (related)</kau:alignsTo>
        <skos:relatedMatch rdf:resource="https://spec.industrialontologies.org/ontology/construct/FailureEvent"/>
        <kau:alignsTo>ISO 14224: Failure event record (related)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-07-contracts-warranty/ServiceCampaign">
        <rdfs:label>ServiceCampaign</rdfs:label>
        <rdfs:comment>A factory-issued Product Improvement Program (PIP), safety recall or retrofit that must be completed on affected units.</rdfs:comment>
        <skos:altLabel>PIP</skos:altLabel>
        <skos:altLabel>Product Improvement Program</skos:altLabel>
        <skos:altLabel>Field campaign</skos:altLabel>
        <skos:altLabel>Recall</skos:altLabel>
        <kau:icon>📢</kau:icon>
        <kau:color>#1A5276</kau:color>
        <kau:processDomain>Contracts &amp; Warranty</kau:processDomain>
        <kau:dataOwner>Warranty Administrator / Product Support</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>ACCC Product Safety: Recall (related)</kau:alignsTo>
        <kau:alignsTo>schema.org: Action (broadMatch)</kau:alignsTo>
        <skos:broadMatch rdf:resource="https://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-07-contracts-warranty/RentalAgreement">
        <rdfs:label>RentalAgreement</rdfs:label>
        <rdfs:comment>A rental contract for one or more rental-fleet units (e.g. from the Truganina rental and remarketing hub), with rates, term and on/off-hire dates.</rdfs:comment>
        <skos:altLabel>Rental order (Annata)</skos:altLabel>
        <skos:altLabel>Hire agreement</skos:altLabel>
        <kau:icon>🔑</kau:icon>
        <kau:color>#1A5276</kau:color>
        <kau:processDomain>Contracts &amp; Warranty</kau:processDomain>
        <kau:dataOwner>Rental Manager</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>FIBO: Contract (broadMatch)</kau:alignsTo>
        <skos:broadMatch rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract"/>
        <kau:alignsTo>schema.org: RentAction (closeMatch)</kau:alignsTo>
        <skos:closeMatch rdf:resource="https://schema.org/RentAction"/>
    </owl:Class>

