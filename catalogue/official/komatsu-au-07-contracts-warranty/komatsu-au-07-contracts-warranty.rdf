        <kau:columnMapping>name=msdyn_name</kau:columnMapping>
        <kau:columnMapping>latitude=msdyn_latitude</kau:columnMapping>
        <kau:columnMapping>longitude=msdyn_longitude</kau:columnMapping>
    </kau:DataBinding>

