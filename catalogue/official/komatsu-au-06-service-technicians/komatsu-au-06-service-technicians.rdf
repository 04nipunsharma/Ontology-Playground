    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-06-service-technicians/ResourceBooking">
        <rdfs:label>ResourceBooking</rdfs:label>
        <rdfs:comment>A scheduled allocation of a technician or bay to a work order, PDI job or reman job.</rdfs:comment>
        <kau:icon>📅</kau:icon>
        <kau:color>#D83B01</kau:color>
        <kau:processDomain>Service &amp; Technicians</kau:processDomain>
        <kau:dataOwner>Service Planner / PDI Planner</kau:dataOwner>
        <kau:systemOfRecord>D365 CE</kau:systemOfRecord>
        <kau:alignsTo>schema.org: Reservation (closeMatch)</kau:alignsTo>
        <skos:closeMatch rdf:resource="https://schema.org/Reservation"/>
        <kau:alignsTo>Microsoft CDM: BookableResourceBooking (closeMatch)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-06-service-technicians/TimeEntry">
        <rdfs:label>TimeEntry</rdfs:label>
        <rdfs:comment>Labour time recorded by a technician against a work order job, PDI job or reman job.</rdfs:comment>
        <skos:altLabel>Labour line</skos:altLabel>
        <skos:altLabel>Hour journal</skos:altLabel>
        <skos:altLabel>Timesheet</skos:altLabel>
        <kau:icon>⏱️</kau:icon>
        <kau:color>#D83B01</kau:color>
        <kau:processDomain>Service &amp; Technicians</kau:processDomain>
        <kau:dataOwner>Service Coordinator</kau:dataOwner>
        <kau:systemOfRecord>D365 F&amp;O</kau:systemOfRecord>
        <kau:alignsTo>schema.org: Action (broadMatch)</kau:alignsTo>
        <skos:broadMatch rdf:resource="https://schema.org/Action"/>
        <kau:alignsTo>Microsoft CDM: TimeEntry (closeMatch)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-06-service-technicians/FailureMode">
        <rdfs:label>FailureMode</rdfs:label>
        <rdfs:comment>A coded failure mode, mechanism and cause used on repairs, warranty claims and reman teardowns (ISO 14224 style).</rdfs:comment>
        <skos:altLabel>Claim code (Annata: symptom, cause, resolution, failure)</skos:altLabel>
        <skos:altLabel>Damage code</skos:altLabel>
        <kau:icon>💥</kau:icon>
        <kau:color>#D83B01</kau:color>
        <kau:processDomain>Service &amp; Technicians</kau:processDomain>
        <kau:dataOwner>Reliability Engineering</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>ISO 14224: Failure mode / failure mechanism / failure cause (Annex B) (exactMatch)</kau:alignsTo>
        <kau:alignsTo>IOF: FailureModeCode (closeMatch)</kau:alignsTo>
        <skos:closeMatch rdf:resource="https://spec.industrialontologies.org/ontology/construct/FailureModeCode"/>
        <kau:alignsTo>MIMOSA CCOM: HypotheticalEvent (FMECA) (related)</kau:alignsTo>
    </owl:Class>

