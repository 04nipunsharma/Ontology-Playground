    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="https://ontology.komatsu.com.au/komatsu-au-04-parts-supply-chain/replacesPart">
        <rdfs:label>replacesPart</rdfs:label>
        <rdfs:domain rdf:resource="https://ontology.komatsu.com.au/komatsu-au-04-parts-supply-chain/PartInterchange"/>
        <rdfs:range rdf:resource="https://ontology.komatsu.com.au/komatsu-au-04-parts-supply-chain/Part"/>
        <rdfs:comment>An interchange record replaces an old part number</rdfs:comment>
        <kau:cardinality>many-to-one</kau:cardinality>
        <kau:fromEntityId>partInterchange</kau:fromEntityId>
