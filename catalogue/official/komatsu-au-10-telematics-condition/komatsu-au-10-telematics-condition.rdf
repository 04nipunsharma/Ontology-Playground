    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-10-telematics-condition/binding_machineModel">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-10-telematics-condition/MachineModel"/>
        <kau:boundEntityId>machineModel</kau:boundEntityId>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:source>Lakehouse · lh_d365 (Link to Fabric: Dataverse + F&amp;O)</kau:source>
        <kau:table>lh_d365.dbo.amdevicemodel</kau:table>
        <kau:alternateTable>msauto_devicemodel / msauto_devicemodelcode (Dataverse)</kau:alternateTable>
        <kau:toConfirm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</kau:toConfirm>
        <kau:columnMapping>modelCode=modelid</kau:columnMapping>
        <kau:columnMapping>series=modelcode</kau:columnMapping>
        <kau:columnMapping>operatingWeightKg=operatingweight</kau:columnMapping>
        <kau:columnMapping>enginePowerKw=enginepower</kau:columnMapping>
    </kau:DataBinding>

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-10-telematics-condition/binding_equipmentUnit">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-10-telematics-condition/EquipmentUnit"/>
        <kau:boundEntityId>equipmentUnit</kau:boundEntityId>
