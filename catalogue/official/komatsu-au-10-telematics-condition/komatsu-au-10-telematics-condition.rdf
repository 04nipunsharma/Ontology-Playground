        <kau:toConfirm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</kau:toConfirm>
        <kau:columnMapping>serialNumber=serialnumber</kau:columnMapping>
        <kau:columnMapping>pin=vin</kau:columnMapping>
        <kau:columnMapping>stockNumber=deviceid</kau:columnMapping>
        <kau:columnMapping>unitStatus=devicestatus</kau:columnMapping>
        <kau:columnMapping>ownershipType=ownership</kau:columnMapping>
        <kau:columnMapping>smrHours=lastcountervalue</kau:columnMapping>
        <kau:columnMapping>yearOfManufacture=modelyear</kau:columnMapping>
        <kau:columnMapping>deliveryDate=deliverydate</kau:columnMapping>
        <kau:columnMapping>warrantyStartDate=warrantystartdate</kau:columnMapping>
    </kau:DataBinding>

