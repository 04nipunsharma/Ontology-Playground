    <!-- ============================================== -->
    <!-- Data Bindings (system of record → Fabric table) -->
    <!-- ============================================== -->

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/binding_customer">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/Customer"/>
        <kau:boundEntityId>customer</kau:boundEntityId>
        <kau:systemOfRecord>D365 F&amp;O</kau:systemOfRecord>
        <kau:source>Lakehouse · lh_d365 (Link to Fabric: Dataverse + F&amp;O)</kau:source>
        <kau:table>lh_d365.dbo.custtable</kau:table>
        <kau:rowFilter>dataareaid = &apos;kau&apos;</kau:rowFilter>
        <kau:alternateTable>account (Dataverse, dual-write: accountnumber = accountnum)</kau:alternateTable>
        <kau:columnMapping>customerAccount=accountnum</kau:columnMapping>
        <kau:columnMapping>name=dirpartytable.name</kau:columnMapping>
        <kau:columnMapping>abn=vatnum</kau:columnMapping>
        <kau:columnMapping>segment=segmentid</kau:columnMapping>
        <kau:columnMapping>customerTier=custgroup</kau:columnMapping>
        <kau:columnMapping>creditLimit=creditmax</kau:columnMapping>
        <kau:columnMapping>paymentTerms=paymtermid</kau:columnMapping>
        <kau:columnMapping>isOnCreditHold=blocked</kau:columnMapping>
    </kau:DataBinding>

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/binding_customerSite">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/CustomerSite"/>
        <kau:boundEntityId>customerSite</kau:boundEntityId>
        <kau:systemOfRecord>D365 CE</kau:systemOfRecord>
        <kau:source>Lakehouse · lh_d365 (Link to Fabric: Dataverse + F&amp;O)</kau:source>
        <kau:table>lh_d365.dbo.msdyn_functionallocation</kau:table>
        <kau:toConfirm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</kau:toConfirm>
        <kau:columnMapping>siteId=msdyn_functionallocationid</kau:columnMapping>
        <kau:columnMapping>name=msdyn_name</kau:columnMapping>
        <kau:columnMapping>latitude=msdyn_latitude</kau:columnMapping>
        <kau:columnMapping>longitude=msdyn_longitude</kau:columnMapping>
    </kau:DataBinding>

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/binding_supplier">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/Supplier"/>
        <kau:boundEntityId>supplier</kau:boundEntityId>
        <kau:systemOfRecord>D365 F&amp;O</kau:systemOfRecord>
        <kau:source>Lakehouse · lh_d365 (Link to Fabric: Dataverse + F&amp;O)</kau:source>
        <kau:table>lh_d365.dbo.vendtable</kau:table>
        <kau:alternateTable>msdyn_vendor (Dataverse, dual-write)</kau:alternateTable>
        <kau:columnMapping>vendorAccount=accountnum</kau:columnMapping>
        <kau:columnMapping>name=dirpartytable.name</kau:columnMapping>
        <kau:columnMapping>supplierType=vendgroup</kau:columnMapping>
        <kau:columnMapping>abn=vatnum</kau:columnMapping>
        <kau:columnMapping>countryCode=countryregionid</kau:columnMapping>
    </kau:DataBinding>

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/binding_machineType">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/MachineType"/>
        <kau:boundEntityId>machineType</kau:boundEntityId>
        <kau:systemOfRecord>Reference data</kau:systemOfRecord>
        <kau:source>Lakehouse · lh_reference (curated reference &amp; external feeds)</kau:source>
        <kau:table>lh_reference.dbo.machine_type</kau:table>
        <kau:toConfirm rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</kau:toConfirm>
        <kau:columnMapping>machineTypeCode=machine_type_code</kau:columnMapping>
        <kau:columnMapping>name=name</kau:columnMapping>
        <kau:columnMapping>iso6165Term=iso6165_term</kau:columnMapping>
        <kau:columnMapping>unspscCode=unspsc_code</kau:columnMapping>
        <kau:columnMapping>productLine=product_line</kau:columnMapping>
    </kau:DataBinding>

    <kau:DataBinding rdf:about="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/binding_machineModel">
        <kau:boundClass rdf:resource="https://ontology.komatsu.com.au/komatsu-au-00-equipment-master/MachineModel"/>
