    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/PartsDemandForecast">
        <rdfs:label>PartsDemandForecast</rdfs:label>
        <rdfs:comment>A time-phased demand forecast for a part at a warehouse — statistical, collaborative, fleet-hours (KOMTRAX) or PCR-driven.</rdfs:comment>
        <kau:icon>📊</kau:icon>
        <kau:color>#8764B8</kau:color>
        <kau:processDomain>Demand &amp; Supply Planning</kau:processDomain>
