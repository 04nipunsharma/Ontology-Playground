        <rdfs:label>PurchaseOrder</rdfs:label>
        <rdfs:comment>An order placed on a supplier for parts, services or subcontract work — stock replenishment, emergency (VOR) or direct-delivery.</rdfs:comment>
        <kau:icon>📑</kau:icon>
        <kau:color>#008272</kau:color>
        <kau:processDomain>Parts Supply Chain &amp; Procurement</kau:processDomain>
