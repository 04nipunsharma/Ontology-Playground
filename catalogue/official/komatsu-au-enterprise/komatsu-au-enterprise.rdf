        <kau:dataOwner>Digital Channels Manager</kau:dataOwner>
        <kau:systemOfRecord>Power Pages portal</kau:systemOfRecord>
        <kau:alignsTo>schema.org: Person (related)</kau:alignsTo>
        <skos:relatedMatch rdf:resource="https://schema.org/Person"/>
        <kau:alignsTo>W3C VCard / FOAF: OnlineAccount (closeMatch)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/TelematicsReading">
        <rdfs:label>TelematicsReading</rdfs:label>
        <rdfs:comment>A KOMTRAX snapshot of a unit — hours, fuel, idle, location and utilisation — aligned to the ISO 15143-3 (AEMP 2.0) data elements.</rdfs:comment>
        <kau:icon>📡</kau:icon>
        <kau:color>#E81123</kau:color>
        <kau:processDomain>Telematics &amp; Condition Monitoring</kau:processDomain>
        <kau:dataOwner>Digital Solutions (KOMTRAX)</kau:dataOwner>
        <kau:systemOfRecord>KOMTRAX</kau:systemOfRecord>
        <kau:alignsTo>ISO 15143-3: Fleet snapshot (CumulativeOperatingHours, FuelUsed, Location) (exactMatch)</kau:alignsTo>
        <kau:alignsTo>MIMOSA CCOM: Measurement (closeMatch)</kau:alignsTo>
        <kau:alignsTo>schema.org: Observation (closeMatch)</kau:alignsTo>
        <skos:closeMatch rdf:resource="https://schema.org/Observation"/>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/MeterReading">
        <rdfs:label>MeterReading</rdfs:label>
        <rdfs:comment>A service-meter (SMR) or odometer reading recorded against a unit in Annata — from KOMTRAX, a technician, the customer portal or a delivery.</rdfs:comment>
        <skos:altLabel>SMR</skos:altLabel>
        <skos:altLabel>SMU</skos:altLabel>
        <skos:altLabel>Counter reading (Annata)</skos:altLabel>
        <skos:altLabel>Hour meter</skos:altLabel>
        <kau:icon>🔢</kau:icon>
        <kau:color>#E81123</kau:color>
        <kau:processDomain>Telematics &amp; Condition Monitoring</kau:processDomain>
        <kau:dataOwner>Equipment Administration</kau:dataOwner>
        <kau:systemOfRecord>Annata 365 (F&amp;O)</kau:systemOfRecord>
        <kau:alignsTo>MIMOSA CCOM: Measurement (closeMatch)</kau:alignsTo>
        <kau:alignsTo>schema.org: QuantitativeValue (related)</kau:alignsTo>
        <skos:relatedMatch rdf:resource="https://schema.org/QuantitativeValue"/>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/MachineAlert">
        <rdfs:label>MachineAlert</rdfs:label>
        <rdfs:comment>A KOMTRAX caution or fault event, maintenance-due notice, geofence or curfew breach raised for a unit.</rdfs:comment>
        <skos:altLabel>KOMTRAX caution</skos:altLabel>
        <skos:altLabel>IoT alert</skos:altLabel>
        <kau:icon>🚨</kau:icon>
        <kau:color>#E81123</kau:color>
        <kau:processDomain>Telematics &amp; Condition Monitoring</kau:processDomain>
        <kau:dataOwner>Digital Solutions (KOMTRAX)</kau:dataOwner>
        <kau:systemOfRecord>D365 CE</kau:systemOfRecord>
        <kau:alignsTo>ISO 15143-3: Fault codes / caution messages (closeMatch)</kau:alignsTo>
        <kau:alignsTo>MIMOSA CCOM: Event (closeMatch)</kau:alignsTo>
        <kau:alignsTo>Microsoft CDM: IoTAlert (closeMatch)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/FaultCode">
        <rdfs:label>FaultCode</rdfs:label>
        <rdfs:comment>A machine-generated diagnostic trouble code (Komatsu error code, mapped to SAE J1939 SPN/FMI where applicable).</rdfs:comment>
        <kau:icon>⚠️</kau:icon>
        <kau:color>#E81123</kau:color>
        <kau:processDomain>Telematics &amp; Condition Monitoring</kau:processDomain>
        <kau:dataOwner>Product Support Engineering</kau:dataOwner>
        <kau:systemOfRecord>KOMTRAX</kau:systemOfRecord>
        <kau:alignsTo>SAE J1939-73: Diagnostic Trouble Code (SPN + FMI) (exactMatch)</kau:alignsTo>
        <kau:alignsTo>ISO 15143-3: FaultCode (closeMatch)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/OilSample">
        <rdfs:label>OilSample</rdfs:label>
        <rdfs:comment>An oil analysis sample (KOWA, Condition Monitoring Services) taken from a unit compartment, with a laboratory condition rating.</rdfs:comment>
        <skos:altLabel>KOWA sample</skos:altLabel>
        <skos:altLabel>CMS sample</skos:altLabel>
        <skos:altLabel>Fluid analysis</skos:altLabel>
        <kau:icon>🧪</kau:icon>
        <kau:color>#E81123</kau:color>
        <kau:processDomain>Telematics &amp; Condition Monitoring</kau:processDomain>
        <kau:dataOwner>Condition Monitoring</kau:dataOwner>
        <kau:systemOfRecord>LIMC (oil analysis lab)</kau:systemOfRecord>
        <kau:alignsTo>ISO 14224: Condition monitoring (related)</kau:alignsTo>
        <kau:alignsTo>MIMOSA CCOM: Measurement (closeMatch)</kau:alignsTo>
        <kau:alignsTo>schema.org: MedicalTest (related)</kau:alignsTo>
        <skos:relatedMatch rdf:resource="https://schema.org/MedicalTest"/>
    </owl:Class>

