        <kau:alignsTo>ASCM SCOR DS: Source: Schedule product deliveries (related)</kau:alignsTo>
    </owl:Class>

    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/Opportunity">
