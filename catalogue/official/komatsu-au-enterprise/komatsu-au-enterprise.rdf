    <owl:Class rdf:about="https://ontology.komatsu.com.au/komatsu-au-enterprise/GoodsReceipt">
        <rdfs:label>GoodsReceipt</rdfs:label>
        <rdfs:comment>The receipt of goods against a purchase or factory order at a warehouse, including discrepancies.</rdfs:comment>
        <kau:icon>📥</kau:icon>
        <kau:color>#008272</kau:color>
        <kau:processDomain>Parts Supply Chain &amp; Procurement</kau:processDomain>
        <kau:dataOwner>Parts Operations Manager</kau:dataOwner>
        <kau:systemOfRecord>D365 F&amp;O</kau:systemOfRecord>
